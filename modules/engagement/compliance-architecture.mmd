/* Recognition Page Modern Smooth Theme */
.recognition-area {
	background: transparent;
	padding: 20px 0 30px;
}
.recognition-area .card {
	border: none !important;
	border-radius: 20px !important;
	box-shadow: 0 12px 28px rgba(20, 41, 78, 0.06);
	background: rgba(255, 255, 255, 0.82);
	border: 1px solid rgba(164, 179, 214, 0.25);
	transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.recognition-area .card:hover {
	transform: translateY(-2px);
	box-shadow: 0 12px 38px rgba(20, 41, 78, 0.14);
}

.recognition-area .card-title {
	color: #16407c !important;
	font-weight: 700 !important;
	font-size: 1.1rem;
	letter-spacing: 0.01em;
}
.recognition-area .card-body {
	padding: 24px !important;
}
.recognition-area .form-group {
	margin-bottom: 1.1rem;
	width: 100%;
}
.recognition-area .form-control {
	border: 1px solid #cdd9e8;
	border-radius: 8px;
	padding: .58rem .75rem;
	box-shadow: inset 0 1px 2px rgba(0,0,0,0.04);
	transition: border-color 0.2s, box-shadow 0.2s;
}
.recognition-area .form-control:focus {
	border-color: #3c8dbc;
	box-shadow: 0 0 0 .2rem rgba(60, 141, 188, 0.2);
}
.recognition-area .btn {
	border-radius: 999px;
	padding: 0.75rem 1.45rem;
	font-weight: 700;
	transition: transform .2s, box-shadow .2s;
}
.recognition-area .btn:hover {
	transform: translateY(-1px);
	box-shadow: 0 7px 16px rgba(0,0,0,0.12);
}
.recognition-area .reaction-buttons {
	display: flex;
	flex-wrap: wrap;
	gap: 0.75rem;
	margin-top: 1rem;
}
.recognition-area .reaction-buttons .btn {
	min-width: 92px;
}
.recognition-area .reaction-count {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	padding: 0.35rem 0.75rem;
	border-radius: 999px;
	background: rgba(42, 76, 125, 0.08);
	color: #2a4c7d;
	font-weight: 600;
}
.recognition-area .recognition-feed .card {
	border-radius: 22px;
}
.recognition-area .recognition-feed .card-body {
	padding: 24px;
}
.recognition-area .recognition-feed .list-group-item {
	background: #f7fbff;
	border: 1px solid #e5eff8 !important;
	border-radius: 14px !important;
	margin-bottom: 0.75rem;
}
.recognition-area .comment-item {
	background: #ffffff;
	border: 1px solid rgba(206, 223, 241, 0.9);
	border-radius: 14px;
	padding: 1rem;
}
.recognition-area .reply-item {
	border-radius: 14px !important;
	background: #f8fbff !important;
}
.recognition-area .reply-actions {
	display: flex;
	justify-content: flex-end;
}
.recognition-area .reply-action {
	color: #0b78d0;
	font-weight: 700;
	cursor: pointer;
	transition: color 0.2s;
}
.recognition-area .reply-action:hover {
	color: #0056b3;
	text-decoration: underline;
}
.recognition-area .comment-form {
	background: #fbfdff;
	border: 1px solid #dce7f4;
	border-radius: 18px;
	padding: 18px;
	margin-top: 1rem;
}
.recognition-area .comment-form textarea {
	border-radius: 8px;
	border: 1px solid #dce7f4;
	min-height: 60px;
	resize: vertical;
	transition: border-color 0.2s, box-shadow 0.2s;
}
.recognition-area .comment-form textarea:focus {
	border-color: #007bff;
	box-shadow: 0 0 0 0.15rem rgba(0, 123, 255, 0.15);
}
.recognition-area .alert {
	border-radius: 14px;
}
.recognition-area .card.card-success .card-header {
	background: linear-gradient(180deg, #effaf1 0%, #ffffff 100%) !important;
}
.recognition-area .card.card-secondary .card-header {
	background: linear-gradient(180deg, #f6f7fb 0%, #ffffff 100%) !important;
}
@media (max-width: 992px) {
	.recognition-area .card-body {
		padding: 18px !important;
	}
	.recognition-area .reaction-buttons {
		justify-content: flex-start;
	}
}

.recent-activity-header {
    background: linear-gradient(180deg, #f6f7fb 0%, #ffffff 100%) !important;
    border-radius: 18px 18px 0 0;
}

.recent-activity-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #16407c;
}

.recent-activity-item {
    border-radius: 14px;
    border: 1px solid #e6eef7 !important;
    background: #ffffff;
    margin-bottom: 0.5rem;
}

.recent-activity-scroll {
    max-height: 170px;
    min-height: 170px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.85rem 1rem 1rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.recent-activity-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
}

.recent-activity-scroll::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 0;
}

.department-leaderboard-scroll {
    max-height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.75rem 1rem 0.75rem;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.department-leaderboard-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}

.department-leaderboard-scroll .list-group-item {
    border-radius: 14px;
    margin-bottom: 0.75rem;
}

.leaderboard-table-scroll {
    max-height: 420px;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.leaderboard-table-scroll table {
    width: 100%;
    margin-bottom: 0;
    border-collapse: collapse;
}

.leaderboard-table-scroll thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #ffffff;
}

.leaderboard-table-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}

.recent-activity-badge {
    font-size: 1rem;
    padding: .45rem 1.1rem;
    border-radius: 999px;
}

.rounded-list-item {
    border-radius: 12px;
    margin-bottom: .5rem;
}

.employee-month-select {
    min-width: 140px;
}

.employee-year-select {
    min-width: 110px;
}

.no-select-arrow {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: none;
    background-color: #fff;
    cursor: not-allowed;
}

.brand-image-opacity {
    opacity: 0.9;
}

@keyframes fadeIn {
	from {
		opacity: 0;
		transform: translateY(10px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

/* Nav tabs styles */
.recognition-nav-tabs {
  border: none !important;

  margin-right: 14.5px;
  margin-top: 20px;
  padding: 0.8rem 1.1rem !important;
  font-weight: 600;
  color: #4b5563;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  background: transparent;
  text-decoration: none;
  margin-left: 13.5px;
  border-radius: 10px 10px 0 0;
    text-decoration: none;
}

.recognition-nav-tabs .nav-item {
  margin: 0;
  list-style: none;
}

.recognition-nav-tabs .nav-link {
  border: none !important;
  border-bottom: 3px solid transparent;
  margin-right: 0;
  padding: 0.8rem 1.2rem !important;
  font-weight: 600;
  color: #4b5563;
  background: transparent;
  border-radius: 10px 10px 0 0;
  transition: all 0.2s ease;
  text-decoration: none;
  display: flex;
  align-items: center;
  min-height: 48px;
  line-height: 1.2;
}

.recognition-nav-tabs .nav-link:hover {
  color: #0b78d0;
  background: rgba(11, 120, 208, 0.04);
}

.recognition-nav-tabs .nav-link.active {
  color: #0b78d0 !important;
  background: rgba(11, 120, 208, 0.10) !important;
  border-bottom: 3px solid #0b78d0 !important;
  box-shadow: inset 0 3px 0 rgba(11, 120, 208, 0.18);
  padding-top: 0.8rem !important;
  padding-bottom: 0.8rem !important;
}

/* Tabs body */
.recognition-tabs-body {
  padding: 22px 20px 18px;
}

.recognition-area .tab-content .tab-pane {
  display: none;
  opacity: 0;
}

.recognition-area .tab-content .tab-pane.show,
.recognition-area .tab-content .tab-pane.active {
  display: block;
  opacity: 1;
  animation: fadeIn 0.25s ease-in;
}

/* Specific recognition styles */
.recognition-area .card {
  border-radius: 18px;
}

.recognition-area .card-header { border-bottom: 1px solid rgba(255, 255, 255, 0.55); background: rgba(255, 255, 255, 0.72); }


.recognition-feed .card-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #16407c;
}

.recognition-feed .card-body {
  padding: 18px;
}

.recognition-feed .btn {
  border-radius: 999px;
  font-weight: 700;
}

.recognition-feed .list-group-item {
  border-radius: 12px;
  border: 1px solid #e5eff8 !important;
  background: #f7fbff;
}

.recognition-feed .lh-relaxed {
  color: #3a4a5a;
  font-size: 0.96rem;
}

.recognition-feed .badge {
  font-size: 0.9rem;
  padding: .45rem 0.9rem;
  border-radius: 999px;
}

.recognition-area .card.card-warning.card-outline,
.recognition-area .card.card-info.card-outline,
.recognition-area .card.card-secondary.card-outline,
.recognition-area .card.card-success.card-outline {
  background: rgba(255, 255, 255, 0.9);
}

#employee-month .card,
#employee-month .card-body,
#employee-month .card-header {
  border-radius: 18px !important;
}

#employee-month .card-header {
  background: rgba(255,255,255,0.75) !important;
}








