<?php

require_once __DIR__ . "/../database/db.php";

header('Content-Type: application/json');

$db = new Database();

if ($db->hasConnectionError()) {
    echo json_encode([
        'success' => false,
        'message' => 'Database connection unavailable.'
    ]);
    exit();
}

$conn = $db->getConnection();

session_start();

define('MAX_ATTEMPTS', 3);
define('LOCKOUT_TIME', 60);

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    echo json_encode([
        'success' => false,
        'message' => 'Invalid request method.'
    ]);
    exit();
}

$employeeid = trim($_POST['employee_id'] ?? '');
$password = $_POST['password'] ?? '';

if ($employeeid === '' || $password === '') {
    echo json_encode([
        'success' => false,
        'locked' => false,
        'message' => 'Employee ID and password are required.'
    ]);
    exit();
}

$ip = $_SERVER['REMOTE_ADDR'] ?? 'unknown';
$key = 'login_attempts_' . $ip . '_' . $employeeid;

if (!isset($_SESSION[$key])) {
    $_SESSION[$key] = [
        'count' => 0,
        'last_attempt' => time()
    ];
}

$attempts = &$_SESSION[$key];

$elapsed = time() - $attempts['last_attempt'];

if ($elapsed > LOCKOUT_TIME) {
    $attempts = [
        'count' => 0,
        'last_attempt' => time()
    ];

    $elapsed = 0;
}

if ($attempts['count'] >= MAX_ATTEMPTS) {

    $remaining_seconds = max(
        0,
        (int)(LOCKOUT_TIME - $elapsed)
    );

    echo json_encode([
        'success' => false,
        'locked' => true,
        'remaining_seconds' => $remaining_seconds,
        'message' => 'Too many failed attempts.'
    ]);

    exit();
}

/*
|--------------------------------------------------------------------------
| Find Employee Account
|--------------------------------------------------------------------------
|
| Production database relationship:
|
| user_account
|   -> employee_id
|
| em_employees
|   -> role_id
|   -> position_id
|   -> employment_status
|
*/

$stmt = $conn->prepare("
    SELECT
        u.user_id,
        u.employee_id,
        u.password,

        e.employee_code,
        e.first_name,
        e.middle_name,
        e.last_name,

        e.position_id,
        e.department_id,
        e.role_id,
        e.employment_status,

        p.position_name,
        r.role_name,
        d.department_name

    FROM user_account u

    INNER JOIN em_employees e
        ON e.employee_id = u.employee_id

    INNER JOIN em_roles r
        ON r.role_id = e.role_id

    INNER JOIN em_positions p
        ON p.position_id = e.position_id

    LEFT JOIN em_departments d
        ON d.department_id = e.department_id

    WHERE e.employee_code = :employeeid
      AND e.employment_status = 'Active'
      AND p.position_name IN ('HR Staff', 'HR Officer')

    LIMIT 1
");

$stmt->execute([
    ':employeeid' => $employeeid
]);

$user = $stmt->fetch(PDO::FETCH_ASSOC);

if (
    $user &&
    $user['employment_status'] === 'Active' &&
    password_verify($password, $user['password'])
) {

    unset($_SESSION[$key]);

    $_SESSION['user_id'] = $user['user_id'];
    $_SESSION['employee_id'] = $user['employee_id'];
    $_SESSION['employee_code'] = $user['employee_code'];

    $_SESSION['employee_name'] = trim(
        $user['first_name'] . ' ' . $user['last_name']
    );

    $_SESSION['role_id'] = $user['role_id'];
    $_SESSION['role_name'] = $user['role_name'];

    $_SESSION['position_id'] = $user['position_id'];
    $_SESSION['position_name'] = $user['position_name'];

    $_SESSION['department_id'] = $user['department_id'];
    $_SESSION['department_name'] = $user['department_name'];

    $_SESSION['last_activity'] = time();

    $updateLogin = $conn->prepare("
        UPDATE user_account
        SET
            last_login = CURRENT_TIMESTAMP,
            failed_login_attempts = 0
        WHERE user_id = :user_id
    ");

    $updateLogin->execute([
        ':user_id' => $user['user_id']
    ]);

    $redirectMap = [
        2  => 'modules/recruitment/index.php',
        3  => 'modules/employee/index.php',
        4  => 'modules/payroll/index.php',
        5  => 'modules/time/index.php',
        6  => 'modules/performance/index.php',
        7  => 'modules/learning/index.php',
        8  => 'modules/compliance/index.php',
        9  => 'modules/workforce/index.php',
        10 => 'modules/exit/inedex.php',
        11 => 'modules/clinic/index.php',
        12 => 'modules/engagement/index.php',
        13 => 'modules/portal/index.php'
    ];

    $role = (int)$user['role_id'];

    if (!isset($redirectMap[$role])) {

        echo json_encode([
            'success' => false,
            'locked' => false,
            'message' => 'Invalid role.'
        ]);

        exit();
    }

    echo json_encode([
        'success' => true,
        'redirect' => $redirectMap[$role]
    ]);

    exit();
}

$attempts['count']++;
$attempts['last_attempt'] = time();

$remaining_attempts = MAX_ATTEMPTS - $attempts['count'];

if ($remaining_attempts <= 0) {

    echo json_encode([
        'success' => false,
        'locked' => true,
        'remaining_seconds' => LOCKOUT_TIME,
        'message' => 'Too many failed attempts. Please try again later.'
    ]);

} else {

    echo json_encode([
        'success' => false,
        'locked' => false,
        'remaining_attempts' => $remaining_attempts,
        'message' => 'Invalid employee ID or password.'
    ]);
}

exit();
