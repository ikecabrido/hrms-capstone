+### 2.5 One helper you can paste
+
+Drop this in your module (e.g. `classes/LdClient.php`) and call it from every save handler above:
+
+```php
+<?php
+/** Minimal client for the Learning & Development inbound API. */
+final class LdClient
+{
+    private const WA_KEY  = 'wa_f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7';
+
+    public static function post(string $endpoint, array $payload, int $actorId = 0): array
+    {
+        if ($actorId > 0 && !isset($payload['created_by'])) {
+            $payload['created_by'] = $actorId;
+        }
+
+        $url = getenv('LD_BASE_URL') ?: '';           // CLI/cron: set the env var
+        if ($url === '' && isset($_SERVER['HTTP_HOST'])) {
+            require_once __DIR__ . '/../../../includes/app-base.php';
+            $url = AppBase::url();                     // web: derive it, never hardcode
+        }
+
+        $ch = curl_init($url . '/modules/learning/api/inbound/' . $endpoint);
+        curl_setopt_array($ch, [
+            CURLOPT_POST           => true,
+            CURLOPT_POSTFIELDS     => json_encode($payload),
+            CURLOPT_HTTPHEADER     => ['Content-Type: application/json', 'X-API-Key: ' . self::WA_KEY],
+            CURLOPT_RETURNTRANSFER => true,
+            CURLOPT_TIMEOUT        => 15,
+            CURLOPT_CONNECTTIMEOUT => 5,
+        ]);
+
+        $body   = curl_exec($ch);
+        $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
+        $error  = curl_error($ch);
+        curl_close($ch);
+
+        if ($body === false) {
+            return ['ok' => false, 'status' => 0, 'error' => $error, 'retryable' => true];
+        }
+
+        $decoded = json_decode($body, true) ?: [];
+
+        return [
+            'ok'        => $status === 200 && ($decoded['success'] ?? false),
+            'status'    => $status,
+            'duplicate' => (bool) ($decoded['duplicate'] ?? false),
+            'id'        => $decoded['id'] ?? null,
+            // 401/405/422 are payload problems — retrying will not help.
+            'retryable' => $status === 0 || $status >= 500,
+            'error'     => $decoded['error'] ?? $decoded['message'] ?? $error,
+        ];
+    }
+}
+```
+
+Surface `['ok' => false, 'retryable' => false, 'error' => …]` on the form instead of a generic
+"could not save" — L&D's 422 messages name the exact field.
