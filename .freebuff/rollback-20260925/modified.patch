+/* -------------------------------------------------------------------------
+ * 6. No page may quietly become URL-only
+ * ---------------------------------------------------------------------- */
+
+section('Every page still has a way in');
+
+// A page nothing links to and no nav carries can only be opened by typing its URL, which
+// is how admin/learning-path and admin/knowledge-transfer were almost lost when their nav
+// entries came out. Any file in the repository counts as a reference: a nav entry, an
+// href, a data-page, a BackLink destination, an AJAX path built in JavaScript.
+//
+// Pages below are deliberately reached only through an entry point, so they are expected
+// to have no inbound reference of their own. Listing one here is a decision; leaving one
+// out is a bug the check catches.
+$entryPointsOnly = [];
+
+$scanRoot = $repoRoot;
+$referencing = [];
+$scanFilter = new RecursiveCallbackFilterIterator(
+    new RecursiveDirectoryIterator($scanRoot, FilesystemIterator::SKIP_DOTS),
+    function (SplFileInfo $file) {
+        if (!$file->isDir()) {
+            return true;
+        }
+        return !in_array($file->getFilename(), ['.git', 'node_modules', 'vendor', 'rainz'], true);
+    }
+);
+$rootPrefix = strlen(str_replace('\\', '/', $scanRoot)) + 1;
+foreach (new RecursiveIteratorIterator($scanFilter) as $file) {
+    if (!$file->isFile() || !in_array($file->getExtension(), ['php', 'js', 'html'], true)) {
+        continue;
+    }
+    $path = str_replace('\\', '/', $file->getPathname());
+    $referencing[substr($path, $rootPrefix)] = file_get_contents($path);
+}
+
+// Only pages a person can be sent to: an AJAX endpoint's way in is a fetch() call, and a
+// partial is included by the page that owns it. Endpoints nothing calls are dead code,
+// counted and reported below rather than failed here.
+$isBrowsable = static function (string $slug): bool {
+    return strpos($slug, '/ajax/') === false && strpos($slug, '/includes/') === false;
+};
+
+$orphans = [];
+$deadCode = 0;
+$byFilenameOnly = 0;
+foreach ($slugs as $slug) {
+    // A page naming itself is not a way in; nor is this harness, which lists the intended
+    // entry points in $entryPointsOnly.
+    $ownFile = 'modules/learning/pages/' . $slug . '.php';
+
+    // Whole-path boundaries, so admin/user is not "referenced" by admin/user-subpage/…,
+    // while the file form still matches — fetch('pages/admin/ajax/save-kt-plan.php') is
+    // exactly how a screen names the endpoint it calls.
+    $routePattern = '/(?<![A-Za-z0-9_.\-])' . preg_quote($slug, '/') . '(?![A-Za-z0-9_\-])/';
+
+    $routeNamed = false;
+    foreach ($referencing as $path => $contents) {
+        if ($path === $ownFile || $path === 'modules/learning/tests/run-tests.php') {
+            continue;
+        }
+        if (preg_match($routePattern, $contents)) {
+            $routeNamed = true; // named as a route — it has a way in
+            break;
+        }
+    }
+
+    if ($routeNamed) {
+        continue;
+    }
+
+    if ($isBrowsable($slug)) {
+        $orphans[] = $slug;
+        continue;
+    }
+
+    // An endpoint or partial: its way in is its own filename, never the whole route, so a
+    // mention of the name alone is enough — checked separately and only when it matters.
+    $filePattern = '/(?<![A-Za-z0-9_.\-])' . preg_quote(basename($slug), '/') . '(?![A-Za-z0-9_\-])/';
+    $fileNamed = false;
+    foreach ($referencing as $path => $contents) {
+        if ($path === $ownFile || $path === 'modules/learning/tests/run-tests.php') {
+            continue;
+        }
+        if (preg_match($filePattern, $contents)) {
+            $fileNamed = true;
+            break;
+        }
+    }
+
+    if ($fileNamed) {
+        $byFilenameOnly++;
+    } else {
+        $deadCode++;
+    }
+}
+sort($orphans);
+sort($entryPointsOnly);
+
+// Not pages, so not checked: an endpoint's way in is a fetch() call and a partial is
+// included by the page that owns it. Reported so the untouched ones stay visible.
+if ($deadCode > 0 || $byFilenameOnly > 0) {
+    echo '  note ' . $deadCode . ' endpoints/partials are named nowhere at all (dead code) and '
+        . $byFilenameOnly . " are reached only by their own filename\n";
+}
+
+$unlinked = array_values(array_diff($orphans, $entryPointsOnly));
+$staleAllows = array_values(array_diff($entryPointsOnly, $orphans));
+check(
+    'every routable page can be reached (or is a listed entry point)',
+    $unlinked === [] && $staleAllows === [],
+    count($unlinked) . ' unreachable: ' . implode(', ', array_slice($unlinked, 0, 12))
+        . (count($unlinked) > 12 ? ', …' : '')
+        . ' | stale allow-list entries: ' . implode(', ', $staleAllows)
+);
